NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Production example with separate admin site:
# CORS_ORIGIN=https://palavucentre.com,https://admin.palavucentre.com
COOKIE_DOMAIN=
# Set COOKIE_DOMAIN=.palavucentre.com only if you need the admin auth cookie shared across subdomains.
# For Vercel (frontend) -> Render (backend) cross-site cookies, set COOKIE_SAME_SITE=none in production.
COOKIE_SAME_SITE=lax
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=palavu_admin_token

# Optional bootstrap admin for `npm run seed` only.
# Leave empty after initial setup; admin login always validates against DB records.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

ORDER_TAX_PERCENT=5
CURRENCY=INR
OTP_TTL_MINUTES=10
OTP_DEBUG_MODE=true

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google login configuration
# Use the OAuth Web client ID from Google Cloud Console.
# You may pass multiple IDs as a comma-separated list.
GOOGLE_CLIENT_ID=
# Optional: not required for ID-token based login, but kept for future OAuth code flows.
GOOGLE_CLIENT_SECRET=

DEFAULT_HERO_MEDIA_URL=/hero-bg.jpg
DEFAULT_LOGO_URL=
MEDIA_DELETE_ON_REMOVE=true
MAX_UPLOAD_IMAGES=50
MAX_UPLOAD_FILE_SIZE_MB=5
MAX_UPLOAD_SOURCE_FILE_SIZE_MB=20
